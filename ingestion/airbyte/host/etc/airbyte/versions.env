# Pin both versions. Pick them from:
#   abctl:  https://github.com/airbytehq/abctl/releases
#   chart:  the Airbyte platform release notes (docs.airbyte.com/release_notes); chart version = platform version
# Upgrade deliberately (step 15), never by leaving a value at "latest".
ABCTL_VERSION=v0.30.4         # e.g. v0.xx.y
AIRBYTE_CHART_VERSION=2.4.0  # e.g. 1.x.y
