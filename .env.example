# ============================================================================
# Copy to .env and fill in the real values:  cp .env.example .env
# .env is in .gitignore — do not commit it.
#
# This file has two kinds of readers:
#   - notebooks/   -> python-dotenv; load_dotenv() walks up from the cwd
#   - scripts/*.sh -> bash `source`
# Both understand ${VAR} syntax, so a value may reference a variable declared
# above it.
#
# The bash scripts `cd` to the repo root before sourcing, so .env must sit next
# to this file rather than inside scripts/.
# ============================================================================


# ─── AWS, shared ────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1

# Only needed by notebooks/basic_eda.ipynb (DuckDB reads S3 with explicit keys).
# The bash scripts and Terraform use the AWS CLI credential chain and do not
# need these two lines. Leave empty if you don't run that notebook.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ─── Notebook: dbt_emr_test_connect.ipynb ───────────────────────────────────
# Terraform already writes these two into .env.runtime as APPLICATION_ID /
# EXECUTION_ROLE_ARN. They are copied by hand here because the notebook expects
# different names. Quick way to fetch them:
#   cd terraform/environments/dev/compute
#   terraform output -raw emr_application_id
#   terraform output -raw emr_execution_role_arn
EMR_APPLICATION_ID=
EMR_EXECUTION_ROLE_ARN=


# ─── Terraform remote backend ───────────────────────────────────────────────
# Bucket created by terraform/bootstrap. Every stack initialises against it
# under its own state key.
TF_BACKEND_BUCKET=finance-transaction-tf-state-dev-0306
TF_BACKEND_REGION=${AWS_REGION}


# ─── TF_VAR: shared by every stack ──────────────────────────────────────────
TF_VAR_region=${AWS_REGION}


# ─── TF_VAR: bootstrap stack ────────────────────────────────────────────────
# Applied once per account. Must match TF_BACKEND_BUCKET above.
TF_VAR_state_bucket_name=${TF_BACKEND_BUCKET}


# ─── TF_VAR: platform stack ─────────────────────────────────────────────────
# BASE names, WITHOUT the -dev suffix — Terraform appends "-dev" itself.
# Must be globally unique across S3.
TF_VAR_data_lake_bucket_name=finance-transaction-datalake
TF_VAR_code_bucket_name=finance-transaction-codebase

# _setup_infra.sh passes the two below with -var (ecr_registry_name from a
# constant in the script, github_repo from `gh repo view`). Uncomment only if
# you apply the platform stack by hand.
#TF_VAR_ecr_registry_name=emr-serverless-custom
#TF_VAR_github_repo=NghiemCanCode/AWS-batch-data-pipeline

# Days to keep noncurrent versions in the code bucket before deleting them.
# Keep it long enough to roll back the requirements.txt that MWAA pins.
# Defaults to 90.
#TF_VAR_code_bucket_noncurrent_version_days=90


# ─── TF_VAR: compute stack (EMR Serverless) ─────────────────────────────────
TF_VAR_emr_app_name=finance-transaction
TF_VAR_emr_release_label=emr-7.13.0
TF_VAR_is_endpoint=true
TF_VAR_is_studio_enabled=true

# In this stack, data_lake_bucket_name / code_bucket_name mean the names that
# ALREADY carry "-dev" — the opposite of the platform block above.
# _setup_infra.sh passes them with -var from the platform outputs, so do NOT
# redeclare them here. custom_image_uri is likewise built by the script.


# ─── TF_VAR: orchestration stack (MWAA + VPC) ───────────────────────────────
# Name prefix for VPC / subnets / security groups: <prefix>-dev-vpc, ...
TF_VAR_name_prefix=finance-transaction

# BASE name, WITHOUT the -dev suffix — Terraform appends it, same as the bucket
# and EMR names above. The environment ends up as <name>-dev.
TF_VAR_mwaa_environment_name=finance-transaction

# Must be a version MWAA currently supports. Check the MWAA console before
# applying — an invalid version only fails after a long wait.
TF_VAR_airflow_version=3.2.1

# MWAA requires exactly 2 AZs. Wrap in single quotes: this is a JSON list,
# not a string.
TF_VAR_availability_zones='["ap-southeast-1a","ap-southeast-1b"]'

# Everything below has a default. Uncomment only to override.
#TF_VAR_vpc_cidr=10.0.0.0/16
#TF_VAR_single_nat_gateway=true          # false = one NAT per AZ, twice the cost
#TF_VAR_mwaa_environment_class=mw1.small
#TF_VAR_mwaa_min_workers=1
#TF_VAR_mwaa_max_workers=2
#TF_VAR_webserver_access_mode=PUBLIC_ONLY
#TF_VAR_private_webserver_allowed_cidrs='[]'   # only used with PRIVATE_ONLY

# Off in dev: there is no secret to hide yet, and the static config the DAGs read
# lives in YAML under airflow/dags/config/, not in Airflow Variables. Leaving the
# backend on makes EVERY connection lookup - aws_default included - call Secrets
# Manager before falling back to the metadata database.
# Turn it back on when Redshift arrives, and set the two lookup patterns in the
# SAME change so the extra call is limited to names really kept there.
TF_VAR_enable_secrets_manager_backend=false
#TF_VAR_connections_lookup_pattern=^(redshift|snowflake)_
#TF_VAR_variables_lookup_pattern=^secret_
#TF_VAR_secrets_prefix=airflow

# code_bucket_name, data_lake_bucket_name (the names that already carry -dev),
# requirements_s3_object_version, emr_application_id and emr_execution_role_arn
# all come from the platform/compute outputs and must be passed with -var.
# Do NOT set them here — they would clash with the platform block above.


# ─── TF_VAR: serving stack (Athena + Power BI) ──────────────────────────────
# The variable name is misspelled in
# terraform/environments/dev/serving/variables.tf ("ressult"). Kept as-is so the
# names match — don't fix it here.
TF_VAR_ressult_bucket_name=finance-transaction-athena-result

#TF_VAR_gold_data_prefix=gold/iceberg/
#TF_VAR_gold_database_name=gold


# ─── Script: image build ────────────────────────────────────────────────────
IMAGE_TAG=latest

# refresh_runtime_env_dev.sh takes only the part after ":" as the image tag.
#ECR_IMAGE_URI=emr712-spark356-python312:latest


# ─── Script: EMR job runs ───────────────────────────────────────────────────
# Every entry in this block has a default in the script. Set them only to
# override.
#SILVER_ENTRY_POINT=bronze_to_silver_job.py
#SILVER_JOB_NAME=bronze-to-silver-dev
#GOLD_ENTRY_POINT=silver_to_gold_job.py
#GOLD_JOB_NAME=silver-to-gold-dev

# The DATA date, not the run date. See scripts/gold-dbt/README.md.
#BATCH_LOGICAL_DATE=2036-01-01

# Name of the wheel built by poetry. The silver script reads PY_PACKAGE
# (uppercase), refresh_runtime_env_dev.sh reads py_package (lowercase) — set
# both to be safe.
#PY_PACKAGE=aws_pipeline-0.0.1-py3-none-any.whl
#py_package=aws_pipeline-0.0.1-py3-none-any.whl

# Narrow the Silver -> Gold run. Empty means run everything.
#DATASET=
#DATE_START=
#DATE_END=
#WINDOW_START=
#WINDOW_END=
#CURRENCIES=
